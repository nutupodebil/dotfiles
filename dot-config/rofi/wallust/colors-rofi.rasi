/* wallust template at ~/.config/wallust/templates/colors-rofi.rasi */

* {
active-background: #6178A3;
active-foreground: #D0D5DF;
normal-background: #251F20;
normal-foreground: #D0D5DF;
urgent-background: #6178A3;
urgent-foreground: #D0D5DF;

alternate-active-background: #566785;
alternate-active-foreground: #D0D5DF;
alternate-normal-background: #251F20;
alternate-normal-foreground: #D0D5DF;
alternate-urgent-background: #251F20;
alternate-urgent-foreground: #D0D5DF;

selected-active-background: #6178A3;
selected-active-foreground: #251F20;
selected-normal-background: #6178A3;
selected-normal-foreground: #251F20;
selected-urgent-background: #566785;
selected-urgent-foreground: #251F20;

background-color: #251F20;
background: rgba(0,0,0,0.7);
foreground: #D0D5DF;
border-color: #6178A3;

color0: #524A4B;
color1: #434860;
color2: #4C5A72;
color3: #4C5A72;
color4: #667898;
color5: #667898;
color6: #667898;
color7: #B4BBC9;
color8: #7E838C;
color9: #49506C;
color10: #566785;
color11: #566785;
color12: #6178A3;
color13: #6178A3;
color14: #6178A3;
color15: #B4BBC9;


}

