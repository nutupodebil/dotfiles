/* wallust template at ~/.config/wallust/templates/colors-rofi.rasi */

* {
active-background: #936668;
active-foreground: #FAF5F3;
normal-background: #1A1A1C;
normal-foreground: #FAF5F3;
urgent-background: #F2C5B0;
urgent-foreground: #FAF5F3;

alternate-active-background: #936668;
alternate-active-foreground: #FAF5F3;
alternate-normal-background: #1A1A1C;
alternate-normal-foreground: #FAF5F3;
alternate-urgent-background: #1A1A1C;
alternate-urgent-foreground: #FAF5F3;

selected-active-background: #936668;
selected-active-foreground: #1A1A1C;
selected-normal-background: #936668;
selected-normal-foreground: #1A1A1C;
selected-urgent-background: #936668;
selected-urgent-foreground: #1A1A1C;

background-color: #1A1A1C;
background: rgba(0,0,0,0.7);
foreground: #FAF5F3;
border-color: #936668;

color0: #454547;
color1: #3C3C52;
color2: #3C3C52;
color3: #815C5E;
color4: #815C5E;
color5: #B59384;
color6: #B59384;
color7: #F0E9E5;
color8: #A8A3A0;
color9: #414159;
color10: #414159;
color11: #936668;
color12: #936668;
color13: #F2C5B0;
color14: #F2C5B0;
color15: #F0E9E5;


}

