// -*- mode: jsonc -*-
{
    "layer": "top",
    "margin-bottom": -12,
    "margin-top": 0,
    "margin-left": 6,
    "margin-right": 6,
    "height": 52,
    "spacing": -4,

    "reload_style_on_change": true,
    
    
//  GENERAL
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/language",
        "hyprland/window"
    ],
    "modules-center": [
        "power-profiles-daemon",
        "clock",
        "custom/notification"
    ],
    "modules-right": [
        "tray",
        "pulseaudio",
        //"backlight",
        "battery",
        "network",
        "group/hardware",
        "custom/exit"
    ],


    
//  MODULES LEFT
    "hyprland/workspaces": {
        "format": "{}",
        "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e+1'})\"",
        "on-scroll-up":   "hyprctl dispatch \"hl.dsp.focus({workspace = 'e-1'})\"",
        "persistent-workspaces": {
            "*": 4
        }
    },

    "hyprland/language": {
        "format": " {short}",
        "on-click": "hyprctl switchxkblayout current next"
    },

    "hyprland/window": {
        "icon": true,
        "icon-size": 20,
        "max-length": 30,
        //"rewrite": {
        //    "(.*) - Brave": "$1",
        //    "(.*) - Chromium": "$1",
        //    "(.*) - Brave Search": "$1",
        //    "(.*) - Outlook": "$1",
        //    "(.*) Microsoft Teams": "$1"
        //},
    
        "separate-outputs": true,
        "tooltip": false
    },



//  MODUES CENTER
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },

    "clock": {
        "format" : "{0:%H:%M} | {0:%d %b %Y}",
        //"timezone": "Europe/Moscow", // "Europe/Moscow" "Europe/Kaliningrad"
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%d-%m-%Y}"
    },
    
    "custom/notification": {
        "tooltip": true,
        "format": "<span size='16pt'>{icon}</span>",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },


    
//  MODULES RIGHT
    "tray": {
        // "icon-size": 21,
        "spacing": 0
    },

    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            //"phone": "",
            //"portable": "",
            //"car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent} {icon}", //"{percent}% {icon}",
        //"format-icons": ["", "", "", "", "", "", "", "", ""]
        "format-icons": ["🌑", "🌘", "🌗", "🌖", "🌕"],
        //["🌕", "🌖", "🌗", "🌘", "🌑"]
        //["🌑", "🌘", "🌗", "🌖", "🌕"]
        "tooltip": false
    },

    "battery": {
        "states": {
            // "good": 95,
            "warning": 20,
            "critical": 20
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },

    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "group/hardware": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "not-memory",
            "transition-left-to-right": false
        },
        "modules": ["cpu", "memory", "temperature"]//, "hyprland/language", "power-profiles-daemon"]
    },

    "custom/exit": {
        "format" : "⏻",
        "on-click": "wlogout -s", //"~/.scripts/wlogout.sh",
        "on-click-right": "hyprlock",
        "tooltip": true,
        "tooltip-format": "Power menu"
    },

    

    /*
    "bluetooth": {
	"format-connected": "", //" conn",
        "format-disabled": "",
        "format-off": "",
        "interval": 30,
        "on-click": "blueman-manager",
        "format-no-controller": ""
    }
    */

    /*
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },
    */

    /*
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    */
}
